{
  "name": "Aducate Admin App",
  "short_name": "Aducate Admin",
  "id": "/admin-app.html",
  "start_url": "/admin-app.html",
  "scope": "/admin-app.html",
  "display": "standalone",
  "background_color": "#0f172a",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "prefer_related_applications": false
}